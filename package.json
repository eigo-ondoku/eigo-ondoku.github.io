  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "cmu-pronouncing-dictionary": "3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
